# trusTmart Backend — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/trustmart
JWT_SECRET=replace-with-a-strong-random-string
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
DEPLOYER_PRIVATE_KEY=0x_YOUR_DEPLOYER_WALLET_PRIVATE_KEY
CONTRACT_ADDRESS=0x_DEPLOYED_CONTRACT_ADDRESS
SELLER_SERVICE_BASE_URL=http://localhost:4000
NODE_ENV=development

