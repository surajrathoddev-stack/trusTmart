# trusTmart — Environment Configuration Template
# Copy this file to .env and configure for your local or staging environment.
# Never commit real private keys, passwords, or production secrets to Git.

# --- Application Server ---
PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-a-secure-random-256-bit-secret-key

# --- Off-Chain PostgreSQL Database ---
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trustmart

# --- Permissioned Blockchain Network (Primary: Hyperledger Besu QBFT) ---
BLOCKCHAIN_NETWORK=besu-qbft
BESU_RPC_URL=http://127.0.0.1:8545
BESU_CHAIN_ID=1337

# --- Optional Testnet Fallback (Ethereum Sepolia) ---
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# --- Deployer / Transaction Signer ---
# For local Besu prototype, use pre-funded genesis account from blockchain/besu/validators.json
DEPLOYER_PRIVATE_KEY=0x8f2a55949038a9610f50fb23b5883af3b4ecb3c3bb792cbcefbd1542c694be66
CONTRACT_ADDRESS=0x_DEPLOYED_CONTRACT_ADDRESS

# --- Seller Verification Service (Ruchita's Module) ---
# Default FastAPI local development URL
SELLER_SERVICE_BASE_URL=http://127.0.0.1:8000
